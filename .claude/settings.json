{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/branches.sh\" --hook 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/main-guard.cjs\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"],
    "baseRef": "head",
    "bgIsolation": "none"
  }
}
