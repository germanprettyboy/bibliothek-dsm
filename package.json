{
  "name": "library-dsm",
  "private": true,
  "description": "Book list of the library of the Deutsche Schule Mailand (static website) and tools",
  "scripts": {
    "build": "node tools/build.mjs",
    "books": "node tools/generate-books.js data/BIBLIOTHEK_DSM_2024.winbook",
    "encrypt": "node tools/encrypt-admin.js",
    "serve": "python3 -m http.server 8765 -d website",
    "dev": "node tools/build.mjs --watch & npx --yes --prefer-offline browser-sync@3.0.4 start --server website --files website --port 8765 --no-open --no-notify --no-ui",
    "local": "node tools/local.mjs",
    "ui:add": "npx --yes --prefer-offline shadcn@4.22.0 add",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:live": "node tools/tunnel.mjs --test",
    "tunnel": "node tools/tunnel.mjs",
    "tunnel:php": "node tools/local.mjs --tunnel",
    "tunnel:dev": "node tools/tunnel.mjs --dev",
    "branches": "bash tools/branches.sh",
    "integrate": "bash tools/branches.sh integrate"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "sql.js": "1.10.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "preact": "11.0.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  }
}
