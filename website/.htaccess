# Only for an Apache webspace; other servers (e.g. GitHub Pages) ignore this file.
# If the page shows "500 Internal Server Error" after uploading: delete this file.

# Compression: books.js shrinks from a good 700 KB to under 200 KB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript image/svg+xml
</IfModule>

# Hardening: no framing by other pages (clickjacking of the admin page), no MIME guessing,
# cover hosts only learn the origin, never the full address.
# Caching: briefly revalidate pages, scripts and data on every visit (a new book list is visible immediately),
# fonts and images practically never change.
# No directory listings (e.g. assets/); backup/ is locked completely by its own .htaccess (written by save.php)
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# The admin page only works via https (Web Crypto), and its key travels in a header: never via http.
# Webspaces behind a TLS proxy see HTTPS=off internally – X-Forwarded-Proto prevents a redirect loop there.
# The whole site via https: remove the "#" in front of the second RewriteRule once https works on the webspace.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(admin\.html|save\.php)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Browsers that once saw the page via https stay on https (only sent over https; no includeSubDomains: school domain)
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|js|css|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|webp|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
